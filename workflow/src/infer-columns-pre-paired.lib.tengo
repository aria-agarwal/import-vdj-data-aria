maps := import("@platforma-sdk/workflow-tengo:maps")
slices := import("@platforma-sdk/workflow-tengo:slices")
sets := import("@platforma-sdk/workflow-tengo:sets")
json := import("json")
ll := import("@platforma-sdk/workflow-tengo:ll")

common := import(":infer-columns-common")

// Helper to add common annotations for table view properties
a := common.a


// Property specs (subset)
propertyColumnSpecs := {
    "name": {
		id: "name",
		column: "name",
		allowNA: false,
		spec: {
			name: "pl7.app/sample/id",
			valueType: "String",
			annotations: a(100000, true, {
				"pl7.app/label": "Name",
				"pl7.app/description": "Identifier used to pair heavy and light chains.",
                "pl7.app/table/visibility": "default"
			})
		}
	},
    "heavy_sequence": {
		id: "heavy_sequence",
		column: "heavy_sequence",
		allowNA: true,
		spec: {
			name: "pl7.app/vdj/sequence",
			valueType: "String",
			domain: {
				"pl7.app/alphabet": "aminoacid",
				"pl7.app/vdj/feature": "VDJRegion",
				"pl7.app/vdj/pairedRole": "heavy"
			},
			annotations: a(46865, false, {
				"pl7.app/label": "Full AA",
				"pl7.app/vdj/isAssemblingFeature": "true",
				"pl7.app/table/fontFamily": "monospace",
                "pl7.app/table/visibility": "default"
			})
		}
	},
     "light_sequence": {
		id: "light_sequence",
		column: "light_sequence",
		allowNA: true,
		spec: {
			name: "pl7.app/vdj/sequence",
			valueType: "String",
			domain: {
				"pl7.app/alphabet": "aminoacid",
				"pl7.app/vdj/feature": "VDJRegion",
				"pl7.app/vdj/pairedRole": "light"
			},
			annotations: a(46865, false, {
				"pl7.app/label": "Full AA",
				"pl7.app/vdj/isAssemblingFeature": "true",
				"pl7.app/table/fontFamily": "monospace",
                "pl7.app/table/visibility": "default"
			})
		}
	},

    // Optional framework (FR) and CDR segments (amino acid)
    "fr1-aa": {
        id: "fr1-aa",
        column: "fr1-aa",
        allowNA: true,
        spec: {
            name: "pl7.app/vdj/sequence",
            valueType: "String",
            domain: {
                "pl7.app/alphabet": "aminoacid",
                "pl7.app/vdj/feature": "FR1"
            },
            annotations: a(46950, false, {
                "pl7.app/label": "FR1 aa",
                "pl7.app/table/visibility": "optional"
            })
        }
    },
    "fr2-aa": {
        id: "fr2-aa",
        column: "fr2-aa",
        allowNA: true,
        spec: {
            name: "pl7.app/vdj/sequence",
            valueType: "String",
            domain: {
                "pl7.app/alphabet": "aminoacid",
                "pl7.app/vdj/feature": "FR2"
            },
            annotations: a(46930, false, {
                "pl7.app/label": "FR2 aa",
                "pl7.app/table/visibility": "optional"
            })
        }
    },
    "fr3-aa": {
        id: "fr3-aa",
        column: "fr3-aa",
        allowNA: true,
        spec: {
            name: "pl7.app/vdj/sequence",
            valueType: "String",
            domain: {
                "pl7.app/alphabet": "aminoacid",
                "pl7.app/vdj/feature": "FR3"
            },
            annotations: a(46910, false, {
                "pl7.app/label": "FR3 aa",
                "pl7.app/table/visibility": "optional"
            })
        }
    },
    "fr4-aa": {
        id: "fr4-aa",
        column: "fr4-aa",
        allowNA: true,
        spec: {
            name: "pl7.app/vdj/sequence",
            valueType: "String",
            domain: {
                "pl7.app/alphabet": "aminoacid",
                "pl7.app/vdj/feature": "FR4"
            },
            annotations: a(46900, false, {
                "pl7.app/label": "FR4 aa",
                "pl7.app/table/visibility": "optional"
            })
        }
    },
    "cdr1-aa": {
        id: "cdr1-aa",
        column: "cdr1-aa",
        allowNA: true,
        spec: {
            name: "pl7.app/vdj/sequence",
            valueType: "String",
            domain: {
                "pl7.app/alphabet": "aminoacid",
                "pl7.app/vdj/feature": "CDR1"
            },
            annotations: a(46940, false, {
                "pl7.app/label": "CDR1 aa",
                "pl7.app/table/visibility": "optional"
            })
        }
    },
    "cdr2-aa": {
        id: "cdr2-aa",
        column: "cdr2-aa",
        allowNA: true,
        spec: {
            name: "pl7.app/vdj/sequence",
            valueType: "String",
            domain: {
                "pl7.app/alphabet": "aminoacid",
                "pl7.app/vdj/feature": "CDR2"
            },
            annotations: a(46935, false, {
                "pl7.app/label": "CDR2 aa",
                "pl7.app/table/visibility": "optional"
            })
        }
    },
     "cdr3-aa": {
        id: "cdr3-aa",
        column: "cdr3-aa",
        allowNA: true,
        spec: {
            name: "pl7.app/vdj/sequence",
            valueType: "String",
            domain: {
                "pl7.app/alphabet": "aminoacid",
                "pl7.app/vdj/feature": "CDR3"
            },
            annotations: a(99000, true, {
                "pl7.app/label": "CDR3 aa",
                "pl7.app/description": "The amino acid sequence of the CDR3 region.",
                "pl7.app/table/visibility": "optional"
            })
        }
    }
}

// Centralize shared specs (common wins for overlapping keys).

requiredColumns := ["name", "heavy_sequence", "light_sequence"]
optionalColumns := ["fr1-aa","fr2-aa","fr3-aa","fr4-aa","cdr1-aa","cdr2-aa","cdr3-aa"]

getColumns := func(header, customMapping) {

    columnMapping := {}
	for canonical in requiredColumns {
		source := customMapping[canonical]
		if !is_undefined(source) && source != "" {
			columnMapping[canonical] = source
		}
	}
    for canonical in optionalColumns {
		source := customMapping[canonical]
		if !is_undefined(source) && source != "" {
			columnMapping[canonical] = source
		}
	}

    // 'name' is the join key / clonotypeKey — included as-is (not duplicated)
    propertyColumns := []
    if columnMapping["name"] != undefined {
        propertyColumns = append(propertyColumns, propertyColumnSpecs["name"])
    }

    // Add heavy_sequence and light_sequence as-is (they already have pairedRole in domain)
    if columnMapping["heavy_sequence"] != undefined {
        propertyColumns = append(propertyColumns, propertyColumnSpecs["heavy_sequence"])
    }
    if columnMapping["light_sequence"] != undefined {
        propertyColumns = append(propertyColumns, propertyColumnSpecs["light_sequence"])
    }

    // For optional FR/CDR columns, generate _heavy and _light variants
    optionalCols := {"fr1-aa": true, "fr2-aa": true, "fr3-aa": true, "fr4-aa": true, "cdr1-aa": true, "cdr2-aa": true, "cdr3-aa": true}
    frcdrCols := ["fr1-aa", "fr2-aa", "fr3-aa", "fr4-aa", "cdr1-aa", "cdr2-aa", "cdr3-aa"]
    for col in frcdrCols {
        if columnMapping[col] == undefined { continue }
        baseSpec := propertyColumnSpecs[col]
        if is_undefined(baseSpec) { continue }
        baseLabel := baseSpec.spec.annotations["pl7.app/label"]
        baseDomain := is_undefined(baseSpec.spec.domain) ? {} : baseSpec.spec.domain
        heavySpec := maps.deepMerge(baseSpec, {
            id: col + "_heavy",
            column: col + "_heavy",
            spec: {
                domain: maps.merge(baseDomain, { "pl7.app/vdj/pairedRole": "heavy" }),
                annotations: maps.merge(baseSpec.spec.annotations, {
                    "pl7.app/label": baseLabel + " (Heavy)",
                    "pl7.app/table/visibility": "optional"
                })
            }
        })
        lightSpec := maps.deepMerge(baseSpec, {
            id: col + "_light",
            column: col + "_light",
            spec: {
                domain: maps.merge(baseDomain, { "pl7.app/vdj/pairedRole": "light" }),
                annotations: maps.merge(baseSpec.spec.annotations, {
                    "pl7.app/label": baseLabel + " (Light)",
                    "pl7.app/table/visibility": "optional"
                })
            }
        })
        propertyColumns = append(propertyColumns, heavySpec)
        propertyColumns = append(propertyColumns, lightSpec)
    }

    // Abundance: synthetic read-count = 1 per pair — hidden from table
    readCountSpec := maps.deepMerge(common.readColumnSpecs["read-count"], {})
    readFractionSpec := maps.deepMerge(common.readColumnSpecs["read-fraction"], {})
    readCountSpec.spec.annotations["pl7.app/abundance/isPrimary"] = "true"
    readCountSpec.spec.annotations["pl7.app/isAnchor"] = "true"
    readCountSpec.spec.annotations["pl7.app/table/visibility"] = "hidden"
    readFractionSpec.spec.annotations["pl7.app/abundance/isPrimary"] = "true"
    readFractionSpec.spec.annotations["pl7.app/table/visibility"] = "hidden"

    return {
        propertyColumns: propertyColumns,
        columnMapping: columnMapping,
        clonotypeKeyStructure: "PairedName",
        clonotypeKeyColumns: ["name"],
        abundanceColumns: [readCountSpec, readFractionSpec],
        hasUMIs: false
    }
}

export {
	getColumns: getColumns
}
