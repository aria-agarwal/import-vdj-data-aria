ll := import("@platforma-sdk/workflow-tengo:ll")
self := import("@platforma-sdk/workflow-tengo:tpl.light")
pConstants := import("@platforma-sdk/workflow-tengo:pframes.constants")
slices := import("@platforma-sdk/workflow-tengo:slices")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")
text := import("text")

self.defineOutputs("tsv", "stats")

self.body(func(inputs) {
	inputFiles := inputs[pConstants.VALUE_FIELD_NAME]
	columnsInfo := inputs.columnsInfo
	chains := inputs.chains
	config := inputs.config
	xsvType := "tsv"
	if !is_undefined(config) && !is_undefined(config.xsvType) { xsvType = config.xsvType }

	wf := pt.workflow().mem("8GiB").cpu(4)

	dataFrames := []
	inputMap := inputFiles.inputs()
	for key in maps.getKeys(inputMap) {
		file := inputMap[key]
		dataFrames = append(dataFrames, wf.frame(file, {
			xsvType: xsvType,
			id: "table_" + key,
			inferSchema: false
		}))
	}

	if len(dataFrames) == 0 {
		ll.panic("no input files found")
	}

	df := undefined
	if len(dataFrames) > 1 {
		df = pt.concat(dataFrames)
	} else {
		df = dataFrames[0]
	}

	// Rename original columns to canonical IDs.
	// Strip BOM (\ufeff) from original column names before building rename expressions
	renameExpressions := []
	for canonical in maps.getKeys(columnsInfo.columnMapping) {
		original := columnsInfo.columnMapping[canonical]
		if original == undefined { continue }
		cleanOriginal := text.trim_prefix(original, "\ufeff")
		if canonical != cleanOriginal {
			renameExpressions = append(renameExpressions, pt.col(cleanOriginal).alias(canonical))
		}
	}
	if len(renameExpressions) > 0 {
		df = df.withColumns(renameExpressions...)
	}


	// Split into heavy and light subsets
	heavyDf := df.filter(pt.col("chain").strSlice(0, 3).eq("IGH"))
	lightDf := df.filter(
		pt.col("chain").strSlice(0, 3).eq("IGL").or(pt.col("chain").strSlice(0, 3).eq("IGK"))
	)

	// Collect non-name canonical columns that were actually mapped
	nonNameCols := []
	for col in maps.getKeys(columnsInfo.columnMapping) {
		if col != "name" {
			nonNameCols = append(nonNameCols, col)
		}
	}

	// Rename each non-name column to col_heavy / col_light
	heavyExprs := []
	lightExprs := []
	for col in nonNameCols {
		heavyExprs = append(heavyExprs, pt.col(col).alias(col + "_heavy"))
		lightExprs = append(lightExprs, pt.col(col).alias(col + "_light"))
	}
	if len(heavyExprs) > 0 {
		heavyDf = heavyDf.withColumns(heavyExprs...)
	}
	if len(lightExprs) > 0 {
		lightDf = lightDf.withColumns(lightExprs...)
	}

	// Keep only name + suffixed columns before joining
	heavyKeepCols := ["name"]
	lightKeepCols := ["name"]
	for col in nonNameCols {
		heavyKeepCols = append(heavyKeepCols, col + "_heavy")
		lightKeepCols = append(lightKeepCols, col + "_light")
	}
	heavyDf = heavyDf.select(heavyKeepCols...)
	lightDf = lightDf.select(lightKeepCols...)

	// Full outer join on name: keep rows that only have a heavy or only a light chain
	pairedDf := heavyDf.join(lightDf, { how: "full", on: ["name"], coalesce: true })
	pairedDf = pairedDf.withColumns(pt.col("name").alias("clonotypeKey"))

	// Fill nulls left by the outer join (name present on only one side) with empty string
	fillExprs := []
	for col in nonNameCols {
		fillExprs = append(fillExprs, pt.col(col + "_heavy").fillNull("").alias(col + "_heavy"))
		fillExprs = append(fillExprs, pt.col(col + "_light").fillNull("").alias(col + "_light"))
	}
	if len(fillExprs) > 0 {
		pairedDf = pairedDf.withColumns(fillExprs...)
	}

	// Synthetic abundance
	pairedDf = pairedDf.withColumns(pt.lit(1).cast("Int64").alias("read-count"))
	pairedDf = pairedDf.withColumns(
		pt.col("read-count").truediv(pt.col("read-count").sum()).fillNaN(0).alias("read-fraction")
	)

	// Final column selection
	finalCols := ["clonotypeKey", "name", "read-count", "read-fraction"]
	for col in nonNameCols {
		finalCols = append(finalCols, col + "_heavy")
		finalCols = append(finalCols, col + "_light")
	}
	pairedDf = pairedDf.select(finalCols...)

	pairedDf.save("Paired.tsv")
	statsdf := pairedDf.select([pt.col("clonotypeKey").count().alias("clonotype-count")]...)
	statsdf.saveContent("stats-Paired.tsv")

	wf = wf.run()

	return {
		tsv: { "Paired": wf.getFile("Paired.tsv") },
		stats: { "Paired": wf.getFileContent("stats-Paired.tsv") }
	}
})
