ll := import("@platforma-sdk/workflow-tengo:ll")
self := import("@platforma-sdk/workflow-tengo:tpl.light")
pConstants := import("@platforma-sdk/workflow-tengo:pframes.constants")
slices := import("@platforma-sdk/workflow-tengo:slices")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")

self.defineOutputs("tsv", "stats")

self.body(func(inputs) {
	inputFiles := inputs[pConstants.VALUE_FIELD_NAME]
	columnsInfo := inputs.columnsInfo
	chains := inputs.chains
	config := inputs.config
	xsvType := "tsv"
	if !is_undefined(config) && !is_undefined(config.xsvType) { xsvType = config.xsvType }

	wf := pt.workflow().mem("8GiB").cpu(4)

	dataFrames := []
	inputMap := inputFiles.inputs()
	for key in maps.getKeys(inputMap) {
		file := inputMap[key]
		dataFrames = append(dataFrames, wf.frame(file, {
			xsvType: xsvType,
			id: "table_" + key,
			inferSchema: false
		}))
	}

	if len(dataFrames) == 0 {
		ll.panic("no input files found")
	}

	df := undefined
	if len(dataFrames) > 1 {
		df = pt.concat(dataFrames)
	} else {
		df = dataFrames[0]
	}

	// Rename original columns to canonical IDs.
	renameExpressions := []
	for canonical in maps.getKeys(columnsInfo.columnMapping) {
		original := columnsInfo.columnMapping[canonical]
		if original != undefined && canonical != original {
			renameExpressions = append(renameExpressions, pt.col(original).alias(canonical))
		}
	}
	if len(renameExpressions) > 0 {
		df = df.withColumns(renameExpressions...)
	}

	// Clonotype key is the 'name' column (pairs heavy + light chains by shared name)
	df = df.withColumns(pt.col("name").alias("clonotypeKey"))

	chainToLocusMap := {
		"IGHeavy": ["IGH"],
		"IGLight": ["IGL", "IGK"],
		"TCRAlpha": ["TCRA", "TRAC", "TRA"],
		"TCRBeta": ["TCRB", "TRBC", "TRB"],
		"TCRGamma": ["TCRG", "TRGC", "TRG"],
		"TCRDelta": ["TCRD", "TRDC", "TRD"]
	}

	for chain in chains {
		prefixes := chainToLocusMap[chain]

		chainDf := undefined
		if chain == "IGLight" {
			chainDf = df.filter(
				pt.col("chain").strSlice(0, 3).eq("IGK").or(pt.col("chain").strSlice(0, 3).eq("IGL"))
			)
		} else {
			filterExpr := undefined
			for i := 0; i < len(prefixes); i++ {
				prefix := prefixes[i]
				expr := pt.col("chain").strSlice(0, len(prefix)).eq(prefix)
				if i == 0 {
					filterExpr = expr
				} else {
					filterExpr = filterExpr.or(expr)
				}
			}
			chainDf = df.filter(filterExpr)
		}

		// Add synthetic read-count = 1 per row, then compute read-fraction
		chainDf = chainDf.withColumns(pt.lit(1).cast("Int64").alias("read-count"))
		chainDf = chainDf.withColumns(
			pt.col("read-count").truediv(pt.col("read-count").sum()).fillNaN(0).alias("read-fraction")
		)

		// Keep clonotypeKey, property columns, and abundance columns
		keepColumns := ["clonotypeKey", "read-count", "read-fraction"]
		for col in columnsInfo.propertyColumns {
			keepColumns = append(keepColumns, col.column)
		}
		chainDf = chainDf.select(keepColumns...)

		chainDf.save(chain + ".tsv")

		statsExprs := [pt.col("clonotypeKey").count().alias("clonotype-count")]
		statsdf := chainDf.select(statsExprs...)
		statsdf.saveContent("stats-" + chain + ".tsv")
	}

	wf = wf.run()

	tsv := {}
	stats := {}
	for chain in chains {
		tsv[chain] = wf.getFile(chain + ".tsv")
		stats[chain] = wf.getFileContent("stats-" + chain + ".tsv")
	}

	return {
		tsv: tsv,
		stats: stats
	}
})
