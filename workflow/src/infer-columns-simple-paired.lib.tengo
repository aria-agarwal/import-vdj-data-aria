                "pl7.app/label": "FR1 aa",
                "pl7.app/table/visibility": "optional"
            })
        }
    },
    "fr2-aa": {
        id: "fr2-aa",
        column: "fr2-aa",
        allowNA: true,
        spec: {
            name: "pl7.app/vdj/sequence",
            valueType: "String",
            domain: {
                "pl7.app/alphabet": "aminoacid",
                "pl7.app/vdj/feature": "FR2"
            },
