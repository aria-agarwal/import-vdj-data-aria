                 "pl7.app/label": "Chain",
                 "pl7.app/isDiscreteFilter": "true",
                 "pl7.app/table/visibility": "default"
             })
         }
     },

    // Optional framework (FR) and CDR segments (amino acid)
    "fr1-aa": {
