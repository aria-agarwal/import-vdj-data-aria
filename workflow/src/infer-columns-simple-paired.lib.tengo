// Centralize shared specs (common wins for overlapping keys).

requiredColumns := ["name", "sequence", "chain"]
optionalColumns := ["fr1-aa","fr2-aa","fr3-aa","fr4-aa","cdr1-aa","cdr2-aa","cdr3-aa"]

getColumns := func(header, customMapping) {

    columnMapping := {}
	for canonical in requiredColumns {
		source := customMapping[canonical]
		if !is_undefined(source) && source != "" {
			columnMapping[canonical] = source
		}
	}

    for canonical in optionalColumns {
		source := customMapping[canonical]
		if !is_undefined(source) && source != "" {
			columnMapping[canonical] = source
		}
	}

    // Build arrays based on provided mapping
    presentFrCdrAa := columnMapping["fr1-aa"] != undefined && 
                        columnMapping["cdr1-aa"] != undefined && 
                        columnMapping["fr2-aa"] != undefined && 
                        columnMapping["cdr2-aa"] != undefined && 
                        columnMapping["cdr3-aa"] != undefined && 
                        columnMapping["fr3-aa"] != undefined

    useFrCdr := presentFrCdrAa
    hasVdjAa := columnMapping["sequence"] != undefined
    hasFr4Nt := columnMapping["fr4-nt"] != undefined



    // define mainSequence and assemblingFeature sequence columns
    // Only the specs for which we have columns will be loaded
    // @TODO: check this. For now we just set vdj as main if we have aa and nt
    
    if presentFrCdrAa {
        propertyColumnSpecs["sequence"].spec.annotations["pl7.app/vdj/isMainSequence"] = "true"
        propertyColumnSpecs["sequence"].spec.annotations["pl7.app/vdj/isAssemblingFeature"] = "true"
    }

    // Add property columns from existing columns.
    propertyColumns := []
    for key in maps.getKeys(columnMapping) {
        spec := propertyColumnSpecs[key]
        if !is_undefined(spec) {
            propertyColumns = append(propertyColumns, spec)
        }
    }    

    return {
        propertyColumns: propertyColumns,
        columnMapping: columnMapping
    }
}

export {
	getColumns: getColumns
}
